<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VibeReel" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/vr_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/vr_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        <item name="colorSecondary">@color/vr_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/vr_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/white</item>
        <item name="android:colorBackground">@color/vr_bg</item>
        <item name="colorSurface">@color/vr_surface</item>
        <item name="colorOnSurface">@color/vr_text_primary</item>
        <item name="colorSurfaceVariant">@color/vr_surface_elevated</item>
        <item name="colorOnSurfaceVariant">@color/vr_text_secondary</item>
        <item name="colorOutline">@color/vr_surface_stroke</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="ShapeAppearance.VibeReel.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearance.VibeReel.Rounded16" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
</resources>
