<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="78dp"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="68dp"
        android:layout_height="68dp">

        <View
            android:id="@+id/storyRing"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/bg_story_ring" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgStoryAvatar"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:background="@color/vr_surface"
            android:contentDescription="@string/your_story"
            android:padding="2dp"
            android:scaleType="centerCrop"
            android:src="@drawable/img_default_avatar"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.VibeReel.Circle" />

        <TextView
            android:id="@+id/badgeAddStory"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_sticker_pill"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/txtStoryName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/vr_text_primary"
        android:textSize="12sp" />
</LinearLayout>
