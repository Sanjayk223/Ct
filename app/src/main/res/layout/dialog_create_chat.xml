<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/vr_surface"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/edtGroupTitle"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_chat_bubble_other"
        android:hint="Group Name (e.g. Creators Squad)"
        android:importantForAutofill="no"
        android:inputType="textCapWords"
        android:paddingHorizontal="14dp"
        android:textColor="@color/white"
        android:textColorHint="@color/vr_text_muted"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPickUsers"
        android:layout_width="match_parent"
        android:layout_height="260dp" />
</LinearLayout>
