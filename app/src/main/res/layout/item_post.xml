<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="@color/vr_surface"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/vr_surface_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Post Author Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgPostAuthorAvatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/nav_home"
                android:scaleType="centerCrop"
                android:src="@drawable/img_default_avatar"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.VibeReel.Circle" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtPostAuthorName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/vr_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtPostTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/vr_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtPostCoinsEarned"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_coin_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/vr_gold"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Post Media Frame -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:background="@color/black">

            <ImageView
                android:id="@+id/imgPostMedia"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/nav_home"
                android:scaleType="centerCrop" />

            <androidx.media3.ui.PlayerView
                android:id="@+id/postPlayerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                app:resize_mode="zoom"
                app:use_controller="true" />

            <ImageButton
                android:id="@+id/btnPlayPostVideo"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_sticker_pill"
                android:contentDescription="@string/nav_reels"
                android:padding="14dp"
                android:src="@drawable/ic_play"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtPostSticker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="12dp"
                android:background="@drawable/bg_sticker_pill"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Action Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingTop="8dp">

            <LinearLayout
                android:id="@+id/btnPostLike"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minWidth="48dp"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <ImageView
                    android:id="@+id/imgPostLikeIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/nav_home"
                    android:src="@drawable/ic_heart_outline" />

                <TextView
                    android:id="@+id/txtPostLikesCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/vr_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnPostComment"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minWidth="48dp"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/add_comment_hint"
                    android:src="@drawable/ic_comment" />

                <TextView
                    android:id="@+id/txtPostCommentsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/vr_text_primary"
                    android:textSize="14sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnPostShare"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/nav_home"
                android:src="@drawable/ic_share" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="8dp"
                android:text="+10 🪙 / like"
                android:textColor="@color/vr_gold"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Caption & Hashtags -->
        <TextView
            android:id="@+id/txtPostCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="14dp"
            android:paddingBottom="4dp"
            android:textColor="@color/vr_text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtPostHashtags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="14dp"
            android:paddingBottom="14dp"
            android:textColor="@color/vr_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
