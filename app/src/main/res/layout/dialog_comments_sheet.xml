<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/vr_surface"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Comments"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvComments"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_marginTop="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/edtCommentInput"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chat_bubble_other"
            android:hint="@string/add_comment_hint"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:paddingHorizontal="14dp"
            android:textColor="@color/white"
            android:textColorHint="@color/vr_text_muted"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btnPostCommentSend"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_sticker_pill"
            android:contentDescription="@string/add_comment_hint"
            android:src="@drawable/ic_send" />
    </LinearLayout>
</LinearLayout>
