# Cloudflare R2 (S3-Compatible Object Storage) Configuration
# Set your actual R2 credentials in the Secrets panel in AI Studio.
# Leave these uncommented so BuildConfig fields are generated.
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=YOUR_R2_BUCKET_NAME
R2_PUBLIC_URL=https://pub-your-bucket.r2.dev
